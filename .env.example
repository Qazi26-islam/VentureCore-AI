GEMINI_API_KEY=your_api_key_here
SESSION_SECRET=replace_with_a_long_random_session_secret

# Agent traces older than this many days are pruned automatically.
TRACE_RETENTION_DAYS=30

# Optional paid-tier rates in USD cents per million tokens, keyed by exact model name.
# Leave as {} when using Gemini's free tier, where computed cost is zero.
GEMINI_COST_RATES_JSON={}

# Shopify public-app credentials. Leave blank until a Shopify app is configured.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_customers

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Reconcile connected stores this often to recover missed webhook events.
SHOPIFY_RECONCILE_HOURS=6

# GitHub Actions calls the worker endpoint with this shared secret.
JOB_RUNNER_SECRET=replace_with_a_long_random_secret
APP_URL=https://your-app.example.com
JOB_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=3

# SMTP email delivery. Gmail app passwords or another free SMTP account work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Materiality thresholds. Money values are integer minor units (sen/cents).
ALERT_STOCKOUT_DAYS=14
ALERT_RECEIVABLE_MIN_MINOR=50000
ALERT_EXPENSE_INCREASE_PERCENT=50
ALERT_EXPENSE_INCREASE_MIN_MINOR=10000
ALERT_CASH_DROP_PERCENT=20
ALERT_CASH_DROP_MIN_MINOR=50000
